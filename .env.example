# Optional credentials. Rule-based experiments do not require any API keys.
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
ZHIPU_API_KEY=
LLM_DEFAULT_PROVIDER=auto
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
CIVITAS_RANDOM_SEED=42
CIVITAS_AGENT_LLM_CALL_TIMEOUT_SECONDS=9

# Civitas Lab AI teaching desk (lab/ai.py): per-day call budget and limits.
CIVITAS_LAB_AI_DAILY_CALLS=30
# Optional per-course / per-teacher daily limits (0 = off); the teacher name is self-declared.
CIVITAS_LAB_AI_COURSE_DAILY_CALLS=0
CIVITAS_LAB_AI_TEACHER_DAILY_CALLS=0
CIVITAS_LAB_AI_MAX_TOKENS=3000
CIVITAS_LAB_AI_MAX_INPUT_CHARS=2000
CIVITAS_LAB_AI_ROUTE=auto

# Optional inference profile: lite | standard | enterprise
CIVITAS_INFERENCE_MODE=lite

# Historical provider failures are always errors.
# Synthetic data requires provider_priority=["synthetic"] in the API.

# Optional local model path for standard mode
CIVITAS_LOCAL_MODEL_PATH=

# Optional vLLM model name for enterprise mode
CIVITAS_VLLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
